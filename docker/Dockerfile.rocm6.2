FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ROCM_VERSION=6.2
ENV HIP_PLATFORM=amd

# Install base dependencies
RUN apt-get update && apt-get install -y \
    wget gnupg2 ca-certificates lsb-release \
    build-essential cmake git python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Add ROCm repo
RUN mkdir -p --mode=0755 /etc/apt/keyrings \
    && wget -q -O - https://repo.radeon.com/rocm/rocm.gpg.key | gpg --dearmor -o /etc/apt/keyrings/rocm.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/6.2 jammy main" > /etc/apt/sources.list.d/rocm.list

# Install ROCm
RUN apt-get update && apt-get install -y \
    rocm-hip-sdk rocm-libs rocm-dev \
    && rm -rf /var/lib/apt/lists/*

ENV PATH=/opt/rocm/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/rocm/lib:$LD_LIBRARY_PATH

# Install Python ML frameworks
RUN pip3 install torch torchvision --index-url https://download.pytorch.org/whl/rocm6.2
RUN pip3 install numpy pandas matplotlib

WORKDIR /workspace
CMD ["/bin/bash"]
